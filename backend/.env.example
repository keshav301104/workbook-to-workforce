# ---- LLM ---------------------------------------------------------------
# auto     = use the first provider whose API key is set below, else offline
# offline  = no LLM: lexical routing + deterministic templates (everything still works)
# openai | google_genai | groq | anthropic
LLM_PROVIDER=auto
# LLM_MODEL=gpt-4.1-mini        # optional; sensible default per provider
OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=45

# ---- Engine --------------------------------------------------------------
WORKFLOW_FILE=workflows/AI_Agent_Workflow_Assessment_1.xlsx
PLANS_DIR=workflows/plans
# Below this routing confidence the agent asks which workflow you meant
ROUTER_MIN_CONFIDENCE=0.55

# ---- Simulated external APIs (orders, shipments) -------------------------
SIM_API_LATENCY_MS=250
# Probability that a simulated API call fails (the UI toggle sets this per run)
SIM_FAULT_RATE=0

# ---- Frontend ------------------------------------------------------------
# Addresses of the frontend allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500